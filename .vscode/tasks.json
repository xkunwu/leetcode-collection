{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Create Build Directory",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/build"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "type": "shell",
            "label": "clang++: build active file to build folder",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++20",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "Create Build Directory"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
